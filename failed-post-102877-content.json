  "rawContent": "\n<!-- =========================================================\n     ALLOYPRESS RIGHT FLOATING STACK\n     AI BOX + FLOATING BANNER\n     ---------------------------------------------------------\n     BEHAVIOR:\n     1. Hidden before TL;DR\n     2. Shows at TL;DR\n     3. AI box stays on top\n     4. Banner stays below with a fixed safe gap\n     5. No overlap between widgets\n     6. Both hide before \"AlloyPress Team\"\n     7. Scroll back up = both appear again\n     8. No lock/absolute positioning near footer\n========================================================= -->\n\n\n<!-- =========================\n     AI BOX\n========================= -->\n\n<div class=\"apFloatStack\" id=\"apFloatStack\">\n\n  <div class=\"apAsk-box\">\n\n    <p class=\"apAsk-heading\">\n      Ask AI which software may suit your team\n    </p>\n\n    <div class=\"apAsk-actions\">\n\n      <div class=\"apAsk-pills\">\n\n        <button\n          type=\"button\"\n          class=\"apAsk-pill\"\n          data-tool=\"chatgpt\"\n        >\n          <img decoding=\"async\"\n            src=\"https://alloypress.com/wp-content/uploads/2026/03/ChatGPT-Logo-4.png\"\n            alt=\"ChatGPT\"\n            class=\"apAsk-icon\"\n          >\n          ChatGPT\n        </button>\n\n        <button\n          type=\"button\"\n          class=\"apAsk-pill\"\n          data-tool=\"perplexity\"\n        >\n          <img decoding=\"async\"\n            src=\"https://alloypress.com/wp-content/uploads/2026/03/Perplexity-Logo-1.png\"\n            alt=\"Perplexity\"\n            class=\"apAsk-icon\"\n          >\n          Perplexity\n        </button>\n\n      </div>\n\n\n      <!-- SHARE BUTTON -->\n\n      <div class=\"apShare-wrap\" id=\"apShareWrap\">\n\n        <button\n          type=\"button\"\n          class=\"apShare-btn\"\n          id=\"apShareBtn\"\n          aria-label=\"Share this post\"\n          aria-expanded=\"false\"\n        >\n          <svg\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          >\n            <circle cx=\"18\" cy=\"5\" r=\"3\"></circle>\n            <circle cx=\"6\" cy=\"12\" r=\"3\"></circle>\n            <circle cx=\"18\" cy=\"19\" r=\"3\"></circle>\n            <line x1=\"8.6\" y1=\"10.6\" x2=\"15.4\" y2=\"6.4\"></line>\n            <line x1=\"8.6\" y1=\"13.4\" x2=\"15.4\" y2=\"17.6\"></line>\n          </svg>\n        </button>\n\n\n        <!-- SOCIAL ICONS -->\n\n        <div\n          class=\"apShare-popup\"\n          id=\"apSharePopup\"\n        >\n\n          <a\n            href=\"#\"\n            class=\"apShare-item\"\n            data-share=\"x\"\n            aria-label=\"Share on X\"\n          >\n            <span class=\"apShare-icon apShare-icon-x\">\n              <svg\n                width=\"15\"\n                height=\"15\"\n                viewBox=\"0 0 24 24\"\n                fill=\"currentColor\"\n              >\n                <path d=\"M18.9 2H22l-7.6 8.7L23.3 22h-7.1l-5.5-7.2L4.4 22H1.3l8.1-9.3L1 2h7.3l5 6.6L18.9 2zm-1.2 18h1.9L7.4 4h-2l12.3 16z\"/>\n              </svg>\n            </span>\n          </a>\n\n\n          <a\n            href=\"#\"\n            class=\"apShare-item\"\n            data-share=\"linkedin\"\n            aria-label=\"Share on LinkedIn\"\n          >\n            <span class=\"apShare-icon apShare-icon-linkedin\">\n              <svg\n                width=\"15\"\n                height=\"15\"\n                viewBox=\"0 0 24 24\"\n                fill=\"currentColor\"\n              >\n                <path d=\"M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.59 0 4.25 2.36 4.25 5.44v6.3zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z\"/>\n              </svg>\n            </span>\n          </a>\n\n\n          <a\n            href=\"#\"\n            class=\"apShare-item\"\n            data-share=\"reddit\"\n            aria-label=\"Share on Reddit\"\n          >\n            <span class=\"apShare-icon apShare-icon-reddit\">\n              <svg\n                width=\"15\"\n                height=\"15\"\n                viewBox=\"0 0 24 24\"\n                fill=\"currentColor\"\n              >\n                <path d=\"M22 12.1c0-1.1-.9-2-2-2-.5 0-1 .2-1.35.5-1.3-.9-3.1-1.5-5.1-1.6l.9-4 2.8.6c0 .8.65 1.4 1.4 1.4.8 0 1.4-.65 1.4-1.4 0-.8-.6-1.45-1.4-1.45-.55 0-1 .3-1.25.75l-3.1-.65a.35.35 0 0 0-.4.3l-1 4.45c-2 .1-3.8.7-5.1 1.6-.35-.3-.85-.5-1.35-.5-1.1 0-2 .9-2 2 0 .8.45 1.5 1.1 1.8-.05.25-.05.5-.05.75 0 2.7 3.15 4.9 7 4.9s7-2.2 7-4.9c0-.25 0-.5-.05-.75.65-.3 1.1-1 1.1-1.8z\"/>\n              </svg>\n            </span>\n          </a>\n\n\n          <a\n            href=\"#\"\n            class=\"apShare-item\"\n            data-share=\"instagram\"\n            aria-label=\"Share on Instagram\"\n          >\n            <span class=\"apShare-icon apShare-icon-instagram\">\n              <svg\n                width=\"15\"\n                height=\"15\"\n                viewBox=\"0 0 24 24\"\n                fill=\"currentColor\"\n              >\n                <path d=\"M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.97.24 2.43.4.6.24 1.05.5 1.5.96.46.45.72.9.96 1.5.17.46.36 1.26.4 2.43.07 1.25.07 1.65.07 4.85s0 3.6-.07 4.85c-.05 1.17-.24 1.97-.4 2.43-.24.6-.5 1.05-.96 1.5-.45.46-.9.72-1.5.96-.46.17-1.26.36-2.43.4-1.25.07-1.65.07-4.85.07s-3.6 0-4.85-.07c-1.17-.05-1.97-.24-2.43-.4-.6-.24-1.05-.5-1.5-.96-.46-.45-.72-.9-.96-1.5-.17-.46-.36-1.26-.4-2.43C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.85c.05-1.17.24-1.97.4-2.43.24-.6.5-1.05.96-1.5.45-.46.9-.72 1.5-.96.46-.17 1.26-.36 2.43-.4C8.4 2.2 8.8 2.2 12 2.2z\"/>\n              </svg>\n            </span>\n          </a>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n\n  <!-- =========================\n       FLOATING BANNER\n  ========================== -->\n\n  <a href=\"https://alloypress.com/blogs/best-ai-image-generator\" class=\"apStackBanner\" target=\"_blank\" rel=\"noopener noreferrer\">\n\n    <div class=\"apStackBanner-imgWrap\">\n\n      <img decoding=\"async\"\n        src=\"https://alloypress.com/wp-content/uploads/2026/01/Best-AI-Image-Generators-2026.jpg\"\n        alt=\"Best AI Image Generators 2026\"\n        class=\"apStackBanner-img\"\n      >\n\n      <div class=\"apStackBanner-badge\">\n        🔥 Trending\n      </div>\n\n    </div>\n\n\n    <div class=\"apStackBanner-content\">\n\n      <div class=\"apStackBanner-title\">\n        Best AI Image Generators (2026)\n      </div>\n\n      <div class=\"apStackBanner-sub\">\n        10+ tools tested &amp; ranked\n      </div>\n\n      <div class=\"apStackBanner-cta\">\n        See the Full List →\n      </div>\n\n    </div>\n\n  </a>\n\n</div>\n\n\n<!-- =========================\n     COPY TOAST\n========================= -->\n\n<div\n  id=\"apPasteToast\"\n  class=\"apPasteToast\"\n  role=\"status\"\n  aria-live=\"polite\"\n>\n  <div class=\"apPasteToast-inner\">\n\n    <span>📋</span>\n\n    <span class=\"apPasteToast-text\">\n      Copied! Press <kbd>Ctrl</kbd>+<kbd>V</kbd>.\n    </span>\n\n    <button\n      type=\"button\"\n      class=\"apPasteToast-copyagain\"\n      id=\"apPasteToastCopyAgain\"\n    >\n      Copy again\n    </button>\n\n    <button\n      type=\"button\"\n      class=\"apPasteToast-close\"\n      id=\"apPasteToastClose\"\n      aria-label=\"Dismiss\"\n    >\n      ✕\n    </button>\n\n  </div>\n</div>\n\n\n<!-- =========================\n     SCROLL TOP BUTTON\n========================= -->\n\n<button\n  type=\"button\"\n  id=\"apScrollTopBtn\"\n  aria-label=\"Scroll to top\"\n>\n  <svg\n    width=\"19\"\n    height=\"19\"\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    stroke-width=\"2.7\"\n    stroke-linecap=\"round\"\n    stroke-linejoin=\"round\"\n  >\n    <line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"></line>\n    <polyline points=\"5 12 12 5 19 12\"></polyline>\n  </svg>\n</button>\n\n\n<style>\n\n/* =========================================================\n   MAIN FLOATING STACK\n========================================================= */\n\n.apFloatStack{\n  position:fixed;\n  top:145px;\n  right:24px;\n  width:250px;\n\n  display:flex;\n  flex-direction:column;\n  gap:14px;\n\n  z-index:1000;\n\n  opacity:0;\n  visibility:hidden;\n  pointer-events:none;\n\n  transform:translateY(-8px);\n\n  transition:\n    opacity .25s ease,\n    visibility .25s ease,\n    transform .25s ease;\n}\n\n.apFloatStack.apFloatVisible{\n  opacity:1;\n  visibility:visible;\n  pointer-events:auto;\n  transform:translateY(0);\n}\n\n\n/* =========================================================\n   AI BOX\n========================================================= */\n\n.apFloatStack .apAsk-box{\n  box-sizing:border-box;\n  width:100%;\n\n  border:2px solid #16a34a;\n\n  background:\n    linear-gradient(\n      155deg,\n      #eefaf2 0%,\n      #f7fcf8 50%,\n      #effbf3 100%\n    );\n\n  border-radius:12px;\n\n  padding:13px 14px;\n\n  box-shadow:\n    0 0 0 3px rgba(22,163,74,.08),\n    0 8px 20px rgba(26,29,41,.07);\n}\n\n.apFloatStack .apAsk-heading{\n  margin:0 0 10px;\n  color:#1a1d29;\n  text-align:center;\n  font-size:13px;\n  line-height:1.35;\n  font-weight:650;\n}\n\n.apFloatStack .apAsk-actions{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  gap:8px;\n}\n\n.apFloatStack .apAsk-pills{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  gap:6px;\n}\n\n.apFloatStack .apAsk-pill{\n  display:inline-flex;\n  align-items:center;\n  gap:6px;\n\n  padding:7px 10px;\n\n  border:1px solid #d7dae4;\n  border-radius:999px;\n\n  background:#ffffff;\n  color:#1a1d29;\n\n  font-size:11.5px;\n  font-weight:600;\n  line-height:1;\n\n  cursor:pointer;\n\n  transition:\n    border-color .15s ease,\n    background .15s ease,\n    transform .15s ease;\n}\n\n.apFloatStack .apAsk-pill:hover{\n  border-color:#16a34a;\n  background:#f0fdf4;\n  transform:translateY(-1px);\n}\n\n.apFloatStack .apAsk-pill.apActive{\n  border-color:#15803d;\n  background:#dcfce7;\n}\n\n.apFloatStack .apAsk-icon{\n  width:15px;\n  height:15px;\n  object-fit:contain;\n  display:block;\n}\n\n\n/* =========================================================\n   SHARE\n========================================================= */\n\n.apShare-wrap{\n  position:relative;\n  flex-shrink:0;\n}\n\n.apShare-btn{\n  width:32px;\n  height:32px;\n\n  border-radius:50%;\n  border:1px solid #d7dae4;\n\n  background:#ffffff;\n  color:#1a1d29;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  cursor:pointer;\n\n  transition:\n    border-color .15s ease,\n    background .15s ease,\n    color .15s ease;\n}\n\n.apShare-btn:hover,\n.apShare-wrap.apOpen .apShare-btn{\n  border-color:#16a34a;\n  background:#f0fdf4;\n  color:#16a34a;\n}\n\n\n/* Social icons appear BELOW share button,\n   outside the AI box and without covering it */\n\n.apShare-popup{\n  position:absolute;\n\n  top:calc(100% + 8px);\n  right:0;\n\n  width:32px;\n\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  gap:7px;\n\n  padding:7px 0;\n\n  opacity:0;\n  visibility:hidden;\n  pointer-events:none;\n\n  transform:translateY(-5px);\n\n  transition:\n    opacity .18s ease,\n    visibility .18s ease,\n    transform .18s ease;\n\n  z-index:1100;\n}\n\n.apShare-wrap:hover .apShare-popup,\n.apShare-wrap.apOpen .apShare-popup{\n  opacity:1;\n  visibility:visible;\n  pointer-events:auto;\n  transform:translateY(0);\n}\n\n.apShare-item{\n  width:32px;\n  height:32px;\n\n  border-radius:50%;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  text-decoration:none;\n\n  background:#16a34a;\n\n  box-shadow:\n    0 3px 10px rgba(0,0,0,.13);\n\n  transform:scale(.96);\n\n  transition:\n    transform .15s ease,\n    background .15s ease;\n}\n\n.apShare-item:hover{\n  background:#15803d;\n  transform:scale(1.08);\n}\n\n.apShare-icon{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  color:#ffffff;\n}\n\n\n/* =========================================================\n   FLOATING BANNER\n========================================================= */\n\n.apStackBanner{\n  display:block;\n  width:100%;\n  box-sizing:border-box;\n\n  text-decoration:none;\n\n  background:#ffffff;\n  border:2px solid #22c55e;\n  border-radius:14px;\n\n  overflow:hidden;\n\n  box-shadow:\n    0 0 0 3px rgba(34,197,94,.08),\n    0 7px 18px rgba(20,20,40,.09);\n\n  transition:\n    transform .2s ease,\n    box-shadow .2s ease;\n}\n\n.apStackBanner:hover{\n  transform:translateY(-2px);\n\n  box-shadow:\n    0 0 0 4px rgba(34,197,94,.12),\n    0 10px 24px rgba(20,20,40,.14);\n}\n\n.apStackBanner-imgWrap{\n  position:relative;\n  width:100%;\n  aspect-ratio:16/9;\n  overflow:hidden;\n  background:#f0fdf4;\n}\n\n.apStackBanner-img{\n  width:100%;\n  height:100%;\n  display:block;\n  object-fit:cover;\n\n  transition:transform .3s ease;\n}\n\n.apStackBanner:hover .apStackBanner-img{\n  transform:scale(1.04);\n}\n\n.apStackBanner-badge{\n  position:absolute;\n  top:8px;\n  left:8px;\n\n  padding:3px 7px;\n\n  border-radius:20px;\n\n  background:#15803d;\n  color:#ffffff;\n\n  font-size:9px;\n  font-weight:700;\n}\n\n.apStackBanner-content{\n  padding:11px 12px 13px;\n  text-align:center;\n}\n\n.apStackBanner-title{\n  color:#111827;\n  font-size:13.5px;\n  font-weight:800;\n  line-height:1.3;\n  margin-bottom:4px;\n}\n\n.apStackBanner-sub{\n  color:#6b7280;\n  font-size:10.5px;\n  margin-bottom:10px;\n}\n\n.apStackBanner-cta{\n  display:inline-block;\n\n  padding:7px 12px;\n\n  border:1.5px solid #22c55e;\n  border-radius:7px;\n\n  color:#15803d;\n  background:#ffffff;\n\n  font-size:11px;\n  font-weight:700;\n\n  transition:\n    background .2s ease,\n    color .2s ease;\n}\n\n.apStackBanner:hover .apStackBanner-cta{\n  background:#16a34a;\n  color:#ffffff;\n}\n\n\n/* =========================================================\n   COPY TOAST\n========================================================= */\n\n.apPasteToast{\n  position:fixed;\n  left:50%;\n  bottom:24px;\n\n  transform:\n    translateX(-50%)\n    translateY(20px);\n\n  opacity:0;\n  visibility:hidden;\n  pointer-events:none;\n\n  transition:.25s ease;\n\n  z-index:10000;\n}\n\n.apPasteToast.apShow{\n  opacity:1;\n  visibility:visible;\n  pointer-events:auto;\n\n  transform:\n    translateX(-50%)\n    translateY(0);\n}\n\n.apPasteToast-inner{\n  display:flex;\n  align-items:center;\n  gap:10px;\n\n  max-width:92vw;\n\n  padding:11px 13px;\n\n  border-radius:10px;\n\n  background:#1a1d29;\n  color:#ffffff;\n\n  font-size:13px;\n\n  box-shadow:\n    0 8px 24px rgba(0,0,0,.25);\n}\n\n.apPasteToast-text{\n  flex:1;\n}\n\n.apPasteToast-text kbd{\n  padding:1px 5px;\n\n  border:1px solid #545a70;\n  border-radius:4px;\n\n  background:#3a3f52;\n}\n\n.apPasteToast-copyagain{\n  border:none;\n  border-radius:6px;\n\n  padding:6px 10px;\n\n  background:#16a34a;\n  color:#ffffff;\n\n  cursor:pointer;\n  font-size:12px;\n  font-weight:600;\n}\n\n.apPasteToast-close{\n  border:none;\n  background:transparent;\n\n  color:#aeb4c4;\n\n  cursor:pointer;\n}\n\n\n/* =========================================================\n   SCROLL TOP\n========================================================= */\n\n#apScrollTopBtn{\n  position:fixed;\n\n  right:105px;\n  bottom:28px;\n\n  width:44px;\n  height:44px;\n\n  border:2px solid #16a34a;\n  border-radius:50%;\n\n  background:#16a34a;\n  color:#ffffff;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  cursor:pointer;\n\n  opacity:0;\n  visibility:hidden;\n\n  transform:translateY(10px);\n\n  transition:.2s ease;\n\n  z-index:9999;\n}\n\n#apScrollTopBtn.apShow{\n  opacity:1;\n  visibility:visible;\n  transform:translateY(0);\n}\n\n\n/* =========================================================\n   RESPONSIVE\n========================================================= */\n\n@media(max-width:1350px){\n\n  .apFloatStack{\n    display:none !important;\n  }\n\n}\n\n@media(max-width:480px){\n\n  #apScrollTopBtn{\n    right:76px;\n    bottom:20px;\n    width:42px;\n    height:42px;\n  }\n\n}\n\n</style>\n\n\n<script>\n(function(){\n\n  /* =======================================================\n     PREVENT DUPLICATE STACK\n  ======================================================= */\n\n  if(document.getElementById('apFloatStack')){\n    /* Current stack already exists, so continue safely */\n  }\n\n\n  /* =======================================================\n     SETTINGS\n  ======================================================= */\n\n  var BLOG_URL =\n    'https://alloypress.com/blogs/best-ai-website-builders';\n\n  var SHOW_TEXTS = [\n    'tldr',\n    'tl;dr',\n    'quick summary'\n  ];\n\n  var HIDE_TEXTS = [\n    'alloypress team'\n  ];\n\n  var DESKTOP_BREAKPOINT = 1350;\n\n\n  /* =======================================================\n     ELEMENTS\n  ======================================================= */\n\n  var stack =\n    document.getElementById('apFloatStack');\n\n  if(!stack){\n    return;\n  }\n\n  var shareWrap =\n    document.getElementById('apShareWrap');\n\n  var shareBtn =\n    document.getElementById('apShareBtn');\n\n  var toast =\n    document.getElementById('apPasteToast');\n\n  var copyAgainBtn =\n    document.getElementById('apPasteToastCopyAgain');\n\n  var closeToastBtn =\n    document.getElementById('apPasteToastClose');\n\n  var scrollTopBtn =\n    document.getElementById('apScrollTopBtn');\n\n\n  /* =======================================================\n     POSITION VALUES\n  ======================================================= */\n\n  var showY = null;\n  var hideY = null;\n\n  var ticking = false;\n  var toastTimer = null;\n\n\n  /* =======================================================\n     HELPERS\n  ======================================================= */\n\n  function normalizeText(text){\n\n    return (text || '')\n      .replace(/\\s+/g,' ')\n      .trim()\n      .toLowerCase();\n\n  }\n\n\n  function absoluteTop(el){\n\n    if(!el){\n      return null;\n    }\n\n    var rect =\n      el.getBoundingClientRect();\n\n    return rect.top +\n      (window.scrollY || window.pageYOffset || 0);\n\n  }\n\n\n  /* Find a real heading only */\n\n  function findHeading(snippets){\n\n    var headings =\n      document.querySelectorAll(\n        'h1,h2,h3,h4,h5,h6'\n      );\n\n    for(\n      var i = 0;\n      i < headings.length;\n      i++\n    ){\n\n      var text =\n        normalizeText(\n          headings[i].textContent\n        );\n\n      for(\n        var j = 0;\n        j < snippets.length;\n        j++\n      ){\n\n        if(\n          text.indexOf(\n            snippets[j]\n          ) !== -1\n        ){\n          return headings[i];\n        }\n\n      }\n\n    }\n\n    return null;\n\n  }\n\n\n  /* Broader fallback for AlloyPress Team */\n\n  function findShortTextElement(snippets){\n\n    var elements =\n      document.querySelectorAll(\n        'h1,h2,h3,h4,h5,h6,strong,b,p,div,span'\n      );\n\n    for(\n      var i = 0;\n      i < elements.length;\n      i++\n    ){\n\n      if(\n        elements[i].children.length > 3\n      ){\n        continue;\n      }\n\n      var text =\n        normalizeText(\n          elements[i].textContent\n        );\n\n      if(\n        !text ||\n        text.length > 80\n      ){\n        continue;\n      }\n\n      for(\n        var j = 0;\n        j < snippets.length;\n        j++\n      ){\n\n        if(\n          text.indexOf(\n            snippets[j]\n          ) !== -1\n        ){\n          return elements[i];\n        }\n\n      }\n\n    }\n\n    return null;\n\n  }\n\n\n  /* =======================================================\n     FIND SHOW + HIDE POSITIONS\n  ======================================================= */\n\n  function refreshPositions(){\n\n    var showEl =\n      findHeading(SHOW_TEXTS);\n\n    if(!showEl){\n\n      showEl =\n        findShortTextElement(\n          SHOW_TEXTS\n        );\n    }\n\n\n    var hideEl =\n      findHeading(HIDE_TEXTS);\n\n    if(!hideEl){\n\n      hideEl =\n        findShortTextElement(\n          HIDE_TEXTS\n        );\n    }\n\n\n    /* Show when TL;DR reaches viewport */\n\n    showY = showEl ?\n      absoluteTop(showEl) :\n      700;\n\n\n    /* Hide slightly before AlloyPress Team */\n\n    hideY = hideEl ?\n      absoluteTop(hideEl) - 80 :\n      Math.max(\n        showY + 1000,\n        document.documentElement.scrollHeight -\n        window.innerHeight -\n        500\n      );\n\n  }\n\n\n  /* =======================================================\n     STACK VISIBILITY\n     IMPORTANT:\n     No absolute lock.\n     No footer lock.\n     Just dynamic show/hide.\n  ======================================================= */\n\n  function updateStack(){\n\n    if(\n      window.innerWidth <=\n      DESKTOP_BREAKPOINT\n    ){\n\n      stack.classList.remove(\n        'apFloatVisible'\n      );\n\n      return;\n    }\n\n\n    var scrollY =\n      window.scrollY ||\n      window.pageYOffset ||\n      0;\n\n\n    var shouldShow =\n      scrollY >= showY &&\n      scrollY < hideY;\n\n\n    stack.classList.toggle(\n      'apFloatVisible',\n      shouldShow\n    );\n\n  }\n\n\n  function requestUpdate(){\n\n    if(ticking){\n      return;\n    }\n\n    ticking = true;\n\n    window.requestAnimationFrame(\n      function(){\n\n        updateStack();\n        ticking = false;\n\n      }\n    );\n\n  }\n\n\n  /* =======================================================\n     ASK AI\n  ======================================================= */\n\n  var prompt =\n  