sholdFallback;\n      }\n    }\n\n    function apUpdatePosition() {\n      if (window.innerWidth <= apBreakpoint) {\n        // Mobile/tablet: let the CSS media query own layout completely.\n        if (apWrap.style.position || apWrap.style.top) {\n          apWrap.style.position = '';\n          apWrap.style.top = '';\n        }\n        apWrap.classList.remove('apHiddenBottom', 'apHiddenTop');\n        return;\n      }\n\n      if (!apStopEl) {\n        apStopEl = apFindStopEl();\n      }\n      if (apShowThreshold === null) {\n        apComputeShowThreshold();\n      }\n\n      apWrap.style.position = 'fixed';\n      apWrap.style.top = apTopOffset + 'px';\n\n      // Hide until scrolled past the featured image\n      var apBelowShowPoint = window.scrollY < apShowThreshold;\n\n      var apShouldHideBottom = false;\n\n      if (apStopEl) {\n        var apWrapHeight = apWrap.offsetHeight;\n        var apStopViewportTop = apStopEl.getBoundingClientRect().top;\n        var apFixedBoxBottom = apTopOffset + apWrapHeight;\n        if (apStopViewportTop - apBottomGap < apFixedBoxBottom) {\n          apShouldHideBottom = true;\n        }\n      } else {\n        // Fallback: if we can't find the heading at all (e.g. it's inside\n        // an iframe, or rendered with markup we don't recognize), hide the\n        // widget once the user has scrolled near the bottom of the page so\n        // it can never sit on top of whatever content is down there.\n        var apScrollBottomGap = document.documentElement.scrollHeight - (window.scrollY + window.innerHeight);\n        if (apScrollBottomGap < 650) {\n          apShouldHideBottom = true;\n        }\n      }\n\n      apWrap.classList.toggle('apHiddenTop', apBelowShowPoint);\n      apWrap.classList.toggle('apHiddenBottom', apShouldHideBottom);\n    }\n\n    function apOnScrollOrResize() {\n      // Skip entirely on mobile — no need to even queue a frame.\n      if (window.innerWidth <= apBreakpoint) {\n        apUpdatePosition(